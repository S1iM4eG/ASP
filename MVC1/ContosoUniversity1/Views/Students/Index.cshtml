@* @model IEnumerable<ContosoUniversity1.Models.Student> *@
@model PaginatedList<Student>
@{
    ViewData["Title"] = "Students";
}

<div class="controls">
<h1>Students</h1>
<form asp-action="Index" method="get">
    <lable>
        Поиск по имени:
        <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"
    </lable>
    <input type="submit" value="Поиск" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-dark">Сброс</a>
</form>
<div> 
    <lable formaction="items-per-page">Items per page:</lable>
    <select id="items-per-page" asp-action="Index" asp-route-itemsPerPage="">
        <option value="3">3</option>
        <option value="5">5</option>
        <option value="8">8</option>
    </select>
<div>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>
</div>
<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["NameSortParam"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]">
                        Last name
                        @*  @Html.DisplayNameFor(model => model.LastName) *@
                    </a>
                    @* @Html.DisplayNameFor(model => model.LastName) *@
                </th>
                <th>
                    First name
                    @* @Html.DisplayNameFor(model => model.FirstName) *@
                </th>
                <th>
                    <a asp-action="Index"
                       asp-route-sortOrder="@ViewData["DateSortParam"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]">
                        Enrolment date
                        @* @Html.DisplayNameFor(model => model.EnrollmentDate) *@
                    </a>
                    @* @Html.DisplayNameFor(model => model.EnrollmentDate) *@
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.EnrollmentDate)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Enrollments)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisabled">
        Prev
    </a>
    <div class="pagination-items">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" 
            asp-route-pageIndex="@i" 
            asp-route-searchString="@ViewData["CurrentFilter"]"
            class=@(i== Model.PageIndex ? "selected-page" : "pagination-item")
        >
        @i
        </a>
    }
    </div>

    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>