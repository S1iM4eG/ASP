@model IEnumerable<Academy.Models.Students>

@{
    ViewData["Title"] = "Index";
}
<div class="controls">
<h1>Students</h1>
<form asp-action="Index" method="get">
		<label>
			Поиск по имени:
			<input type="search" name="SearchString" value="@ViewData["CurrentFilter"]" />
			<input type="submit" value="Поиск" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-dark">Сброс</a>
		</label>

	<div>
		<label for="items-per-page">Items per page:</label>
		<select id="items-per-page" name="itemsPerPage" onchange="this.form.submit()">
			<option value="3" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 3)">3</option>
			<option value="5" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 5)">5</option>
			<option value="8" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 8)">8</option>
		</select>
	</div>
	</form>
<div>
		<a asp-action="Create" class="btn btn-primary">Create New</a>
	</div>
<div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.last_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.first_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.middle_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.birth_date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.phone)
            </th>
          @*   <th>
                @Html.DisplayNameFor(model => model.photo)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.group)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.last_name)
            </td>
            <td>
                @Html.DisplayFor(model => item.first_name)
            </td>
            <td>
                @Html.DisplayFor(model => item.middle_name)
            </td>
            <td>
                @Html.DisplayFor(model => item.birth_date)
            </td>
            <td>
                @Html.DisplayFor(model => item.email)
            </td>
            <td>
                @Html.DisplayFor(model => item.phone)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.photo)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.group)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.stud_id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.stud_id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.stud_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
