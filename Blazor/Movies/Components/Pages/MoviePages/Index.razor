@page "/movies"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<div class="input">
    <p>
        <a href="movies/create" class="btn btn-primary">Добавить</a>
    </p>

    <form action="/movies">
        <input type="search" name="titleFilter" />
        <input type="submit" value="Найти" />
    </form>

    <div>
        Items per page:
        <input type="number" min="1" max="50" class="form-control w-auto" @bind="ItemsPerPage" />
    </div>
</div>
<QuickGrid Class="table" Items="FilteredMovie" , Pagination="pagination">
    @* <PropertyColumn Property="movie => movie.Title" /> *@
    <TemplateColumn Context="movie" Title="Название фильма">
        <a href="@($"movies/Details?ID={movie.ID}")">@movie.Title</a>
    </TemplateColumn>
    <PropertyColumn Property="movie => movie.RealeaseDate" />
    <PropertyColumn Property="movie => movie.Genre" />

    @*  <TemplateColumn Context="movie">
        <a href="@($"movies/details?id={movie.ID}")">Details</a> |
    </TemplateColumn> *@
</QuickGrid>
<Paginator State="pagination" />

@code {
    private MoviesContext context = default!;
    [SupplyParameterFromQuery]
    string? titleFilter { get; set; }
    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };
    private int itemsPerPage = 3;
    private int ItemsPerPage
    {
        get => itemsPerPage;
        set
        {
            if (value < 1) value = 1;
            if (itemsPerPage == value) return;

            itemsPerPage = value;
            pagination.ItemsPerPage = value;

            pagination.SetCurrentPageIndexAsync(0);
        }
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    IQueryable<Movie> FilteredMovie => context.Movie.Where(m => m.Title.Contains(titleFilter ?? string.Empty));
}
