@using Academy.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory
@rendermode InteractiveServer
<h3>AddDiscipline</h3>

<form @onsubmit="Update">
    <h5>Выбирите дисциплину</h5>
    <InputSelect @bind-Value="discipline" class="form-control">
        <option selected disabled value="-1"> --- Выбирите дисциплину --- </option>
        @if (Disciplines != null)
        {
            @foreach (Discipline d in Disciplines)
            {
                if (TDR.Any(tdr => tdr.discipline == d.discipline_id) || NewDisciplines.Any(nd => nd.discipline == d.discipline_id)) continue;
                <option value="@d.discipline_id">@d.discipline_name</option>
            }
        }
    </InputSelect>
    <button type="button" class="btn btn-primary" @onclick="AddDiscipline">Добавить</button>
    <ul>
        @foreach (TeachersDisciplinesRelation tdr in NewDisciplines)
        {
            <li>@tdr.Discipline.discipline_name</li>
        }
    </ul>
    <hr />
    <ul>
        @if (TDR != null)
        {
            @foreach (TeachersDisciplinesRelation tdr in TDR)
            {
                <li>@tdr.Discipline.discipline_name</li>
            }
        }
    </ul>
</form>

@code {
    [Parameter]
    public Teacher Teacher { get; set; }
    ICollection<Discipline> Disciplines { get; set; }
    ICollection<TeachersDisciplinesRelation> TDR { get; set; }
    List<TeachersDisciplinesRelation> NewDisciplines = new List<TeachersDisciplinesRelation>();

    int discipline = -1;

    protected override async Task OnInitializedAsync()
    {
        using Academy.Data.AcademyContext context = DbFactory.CreateDbContext();
        Disciplines = await context.Disciplines.ToListAsync();
        TDR = await context.TeachersDisciplinesRelation.Where(t => t.teacher == Teacher.teacher_id).ToListAsync();
    }
    void AddDiscipline()
    {
        if (discipline == -1) return;
        TeachersDisciplinesRelation newRelation = new TeachersDisciplinesRelation { teacher = Teacher.teacher_id, discipline = discipline };
        newRelation.Teacher = Teacher;
        newRelation.Discipline = Disciplines.Where(d => d.discipline_id == discipline).First();
        if (NewDisciplines.Any(d => d.discipline == discipline)) return;
        NewDisciplines.Add(newRelation);
        discipline = -1;
    }
    public async Task Update()
    {
        using Academy.Data.AcademyContext context = DbFactory.CreateDbContext();
        List<TeachersDisciplinesRelation> pairs = new List<TeachersDisciplinesRelation>();
        foreach (TeachersDisciplinesRelation tdr in NewDisciplines) pairs.Add(new TeachersDisciplinesRelation { teacher = Teacher.teacher_id, discipline = tdr.discipline });
        await context.TeachersDisciplinesRelation.AddRangeAsync(pairs);
        await context.SaveChangesAsync();
    }
}
