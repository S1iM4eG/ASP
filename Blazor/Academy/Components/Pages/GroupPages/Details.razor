@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div>
	@if (group is null)
	{
		<p><em>Loading...</em></p>
	}
	else
	{
		<h1>@group.group_name</h1>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">group_name</dt>	<dd class="col-sm-10">@group.group_name</dd>
			<dt class="col-sm-2">direction</dt>		<dd class="col-sm-10">@group.direction</dd>
			<dt class="col-sm-2">start_date</dt>	<dd class="col-sm-10">@group.start_date</dd>
			<dt class="col-sm-2">start_time</dt>	<dd class="col-sm-10">@group.start_time</dd>
			<dt class="col-sm-2">learning_days</dt>	<dd class="col-sm-10">@group.learning_days</dd>
		</dl>
		<div>
			<a href="@($"/groups/edit?group_id={group.group_id}")">Edit</a> |
			<a href="@($"/groups")">Back to List</a>
		</div>
	}
</div>

@code {
	private Group? group;

	[SupplyParameterFromQuery]
	private int group_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		group = await context.Groups.FirstOrDefaultAsync(m => m.group_id == group_id);

		if (group is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
	}
}