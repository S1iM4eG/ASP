<h3>LearningDays</h3>

<ul class="learning-days">
    @for (int i = 0; i < 7; i++)
    {
        int index = i;
        <li>
            <input type="checkbox" id="@Week.DAYNAMES[i]" @bind="@days[index]" @bind:after="Compress" />
            <lable for="@Week.DAYNAMES[i]">@Week.DAYNAMES[i]</lable>
        </li>
    }
</ul>

@code {
    bool[] days = new bool[7];
    [Parameter]
    public Models.Group Group { get; set; }

    int mask;
    void Compress()
    {
        mask = 0;
        for(byte i = 0; i < 7; i++)
        {
            if (days[i]) mask |= (byte)(1 << i);
        }
        Group.learning_days=mask;
    }

     void Extract() {
        for (int i = 0; i < 7; i++) {
            if ((Group.learning_days >> i & 1) != 0)
                days[i] = true;
        }
    }
    protected override void OnInitialized() {
        Extract();
    }
}
